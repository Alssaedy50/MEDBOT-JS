# MEDBOT environment configuration.
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Telegram bot ---
BOT_TOKEN=
ADMIN_ID=

# --- AI providers (any subset; the platform discovers what is available) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Database ---
# Optional explicit path override. On a permanent host use an absolute path,
# e.g. MEDBOT_DB_PATH=/data/medbot_v2.sqlite3
#
# PRODUCTION: MEDBOT stores everything in one SQLite file. On a host whose
# filesystem is ephemeral (a container that is rebuilt on every deploy) the file
# is lost on restart, and every setting/registration with it. Mount a persistent
# volume and point MEDBOT_DB_PATH at it. The effective path is printed at boot as
# `MEDBOT db: <path>` and shown in Admin -> Runtime, so a deploy can be checked
# without guessing. There is no external-DB migration; SQLite is intentional.
MEDBOT_DB_PATH=

# --- Emergency Resource Archive (disaster recovery) ---
# A standalone Telegram channel that mirrors every registered resource so
# students can still reach the material if MEDBOT is down. The bot must be an
# administrator of that channel. Accepts a numeric id (-100...) or an
# @username. Leave unset to disable the feature.
MEDBOT_ARCHIVE_CHANNEL=
