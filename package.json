{
  "name": "medbot-js",
  "version": "1.0.0",
  "private": true,
  "description": "MEDBOT — Telegram medical-education LMS. JavaScript/Node.js implementation of the MEDBOT platform.",
  "type": "module",
  "engines": { "node": ">=22.5.0" },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:watch": "node --test --watch \"test/**/*.test.js\"",
    "lint": "eslint src test",
    "check": "npm run lint && npm test",
    "cf:dev": "npx wrangler dev",
    "cf:deploy": "npx wrangler deploy",
    "cf:export-data": "node scripts/d1-export-data.mjs",
    "restore:resources": "node scripts/rebind-bundle-resources.mjs",
    "restore:secrets": "node scripts/rekey-bundle-secrets.mjs",
    "deploy:check": "node --input-type=module -e \"import('./src/backup/fullBundle.js').then(m => process.exit(m.runDeploymentDoctor ? (m.runDeploymentDoctor().ok ? 0 : 1) : 1))\"",
    "migration:verify": "node --input-type=module -e \"import('./src/db/migrations.js').then(m => process.exit(m.verifyDatabase ? (m.verifyDatabase().ok ? 0 : 1) : 1))\""
  },
  "dependencies": { "dotenv": "^16.4.5" },
  "devDependencies": { "eslint": "^9.13.0" }
}
